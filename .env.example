# Copy this file to .env and adjust values for your environment.

APP_NAME="Social Affairs Management System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/social-affairs/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=social_affairs
DB_USERNAME=social_affairs
DB_PASSWORD=SocialAffairs#2026

SESSION_NAME=sas_session
SESSION_LIFETIME=120
APP_KEY=change-this-to-a-random-32-char-string

# Mail (used for password reset). If left blank, reset links are logged to
# storage/logs/mail.log and shown on-screen in local/debug mode instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@socialaffairs.gov
MAIL_FROM_NAME="Social Affairs Management System"

UPLOAD_MAX_MB=10
