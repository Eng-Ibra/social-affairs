# If your Apache VirtualHost/DocumentRoot points at the project ROOT instead
# of the public/ folder, this redirects everything into public/ so app code,
# .env and vendor/ are never served directly. Prefer pointing DocumentRoot at
# public/ directly (see README) — this file is a safety net only.
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ /public/$1 [L]

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
